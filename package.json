{
  "name": "vocalist-sim",
  "version": "0.1.0",
  "description": "2D-симулятор становления вокалистом. Вертикальный срез.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sim": "tsx src/sim/run.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "play:text": "tsx src/sim/textRun.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abddaler/vocalist-the-game.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/abddaler/vocalist-the-game/issues"
  },
  "homepage": "https://github.com/abddaler/vocalist-the-game#readme",
  "dependencies": {
    "phaser": "^3.90.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "type": "module"
}
